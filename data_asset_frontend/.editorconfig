root = true

# -------------------------
# Global defaults
# -------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Use spaces by default
indent_style = space
indent_size = 2

# -------------------------
# JavaScript / React
# -------------------------
[*.{js,jsx,mjs,cjs}]
indent_size = 2

# -------------------------
# JSON / YAML
# -------------------------
[*.{json,yml,yaml}]
indent_size = 2

# -------------------------
# Markdown
# -------------------------
[*.md]
trim_trailing_whitespace = false
